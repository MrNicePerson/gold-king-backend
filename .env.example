# Database connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/goldking

# Super Admin Initial Credentials
SA_NAME=Super Admin
SA_EMAIL=admin@goldking.com
SA_PASSWORD=SuperAdmin@123!
SA_PHONE=1234567890
SA_SHOP_NAME=GOLDKING
SA_WHATSAPP=1234567890
SA_ADDRESS=
SA_CITY=

# Email configuration
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# JWT Secret
JWT_SECRET=your_jwt_secret_key

# Cloudinary Storage Configuration (REQUIRED FOR PERSISTENT MEDIA STORAGE ON RENDER)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

PORT=5000
NODE_ENV=production
